erDiagram
    %% ===================== ENUMS =====================
    USER_ROLE {
        supplier
        umkm
        admin
    }
    ACCOUNT_STATUS {
        active
        suspended_temporary
        suspended_permanent
        banned
    }
    VERIFICATION_STATUS {
        pending
        approved
        rejected
    }
    BATCH_STATUS {
        draft
        published
        closed
        cancelled
        takedown
        completed
    }
    REGISTRATION_STATUS {
        registered
        pending_payment
        paid
        picked_up
        completed
        no_show
        cancelled
        refund_pending
        refunded
    }
    PAYMENT_STATUS {
        pending
        paid
        expired
        failed
        refunded
    }
    ESCROW_STATUS {
        held
        released
        refunded
        forfeited
    }
    DISPUTE_STATUS {
        pending
        under_review
        resolved_supplier
        resolved_umkm
    }
    REFUND_TRIGGER {
        takedown
        force_majeure
        dispute_won
        supplier_cancel
    }
    REFUND_STATUS {
        pending
        waiting_bank_account
        processing
        completed
        failed
    }
    NOTIFICATION_TYPE {
        payment_due
        payment_success
        pickup_ready
        dispute
        refund
        suspension
        referral
        batch_update
    }
    AUDIT_ACTION {
        verify_supplier
        reject_supplier
        takedown_batch
        resolve_dispute
        approve_refund
        complete_refund
        suspend_user
        ban_user
        unban_user
        cancel_batch
        cut_off_batch
        generate_pickup_code
        confirm_pickup
        create_batch
        update_batch
        delete_batch
    }

    %% ===================== MODULE 1: IAM =====================
    PROFILES {
        uuid id PK "= auth.users.id"
        user_role role
        account_status status
        text full_name
        text phone
        text email "normalized mirror"
        timestamptz created_at
        timestamptz updated_at
    }

    SUPPLIER_PROFILES {
        uuid user_id PK,FK "profiles(id)"
        text business_name
        text address
        numeric latitude
        numeric longitude
        text business_photo_url
        text ktp_photo_url
        text nik UK
        verification_status verification_status
        text verification_notes
        uuid verified_by FK
        timestamptz verified_at
        boolean is_location_locked
        timestamptz created_at
        timestamptz updated_at
    }

    SUPPLIER_BANK_ACCOUNTS {
        uuid id PK
        uuid supplier_id FK "profiles(id)"
        text bank_name
        text account_number
        text account_holder_name
        boolean is_primary
        timestamptz created_at
        timestamptz updated_at
        unique(supplier_id, account_number)
    }

    UMKM_PROFILES {
        uuid user_id PK,FK "profiles(id)"
        text business_name
        text address
        numeric latitude
        numeric longitude
        integer strike_count
        timestamptz suspended_until
        timestamptz created_at
        timestamptz updated_at
    }

    UMKM_BANK_ACCOUNTS {
        uuid id PK
        uuid umkm_id FK "profiles(id)"
        text bank_name
        text account_number
        text account_holder_name
        timestamptz created_at
        timestamptz updated_at
        unique(umkm_id, account_number)
    }

    %% ===================== MODULE 2: CATALOG =====================
    RECURRING_CONFIGS {
        uuid id PK
        uuid supplier_id FK "profiles(id)"
        integer interval_days
        int[] days_of_week
        timestamptz next_generation_at
        timestamptz created_at
        timestamptz updated_at
    }

    BATCHES {
        uuid id PK
        uuid supplier_id FK "profiles(id)"
        uuid recurring_config_id FK
        text title
        text description
        text category
        integer min_quantity
        text pickup_address
        text pickup_name
        numeric latitude
        numeric longitude
        text product_photo_url
        batch_status status
        text takedown_reason
        uuid takedown_by FK
        timestamptz takedown_at
        text cancelled_reason
        timestamptz created_at
        timestamptz updated_at
    }

    BATCH_TIERS {
        uuid id PK
        uuid batch_id FK "batches(id)"
        integer tier_number
        integer min_volume
        integer max_volume
        numeric price_per_unit
        unique(batch_id, tier_number)
    }

    BATCH_TIMELINE {
        uuid batch_id PK,FK "batches(id)"
        timestamptz registration_opens_at
        timestamptz registration_closes_at
        timestamptz payment_opens_at
        timestamptz payment_closes_at
        timestamptz estimated_ready_at
        CHECK(registration_opens_at < registration_closes_at < payment_opens_at < payment_closes_at < estimated_ready_at)
    }

    %% ===================== MODULE 3&4: ORDERS =====================
    REGISTRATIONS {
        uuid id PK
        uuid batch_id FK "batches(id)"
        uuid umkm_id FK "profiles(id)"
        integer quantity
        integer locked_tier_number
        numeric locked_price_per_unit
        numeric final_amount
        registration_status status
        timestamptz consented_at
        numeric consent_latitude
        numeric consent_longitude
        timestamptz created_at
        timestamptz updated_at
        unique(batch_id, umkm_id)
    }

    REGISTRATION_COUNTERS {
        uuid batch_id PK,FK "batches(id)"
        integer current_count
        timestamptz updated_at
    }

    %% ===================== MODULE 5: PAYMENT =====================
    PAYMENTS {
        uuid id PK
        uuid registration_id FK UK "registrations(id)"
        text midtrans_order_id UK
        text midtrans_transaction_id
        numeric gross_amount
        payment_status status
        text qr_code_url
        timestamptz qr_code_expires_at
        timestamptz paid_at
        timestamptz reconciled_at
        jsonb webhook_payload
        timestamptz created_at
        timestamptz updated_at
    }

    PAYMENT_WEBHOOK_LOGS {
        uuid id PK
        uuid registration_id FK "registrations(id)"
        jsonb payload
        text status
        text error
        timestamptz received_at
    }

    %% ===================== MODULE 6: FULFILLMENT =====================
    PICKUP_CODES {
        uuid id PK
        uuid registration_id FK UK "registrations(id)"
        text qr_code_token UK
        text pin_code "4 digits"
        timestamptz used_at
        uuid used_by_supplier_id FK "profiles(id)"
        timestamptz created_at
    }

    PICKUP_EVENTS {
        uuid id PK
        uuid registration_id FK "registrations(id)"
        text method "qr|pin"
        uuid supplier_id FK "profiles(id)"
        numeric latitude
        numeric longitude
        timestamptz created_at
    }

    %% ===================== MODULE 7: ESCROW & DISPUTES =====================
    ESCROW_HOLDS {
        uuid id PK
        uuid registration_id FK UK "registrations(id)"
        numeric amount
        timestamptz pickup_confirmed_at
        timestamptz auto_release_at
        escrow_status status
        text release_destination "supplier|umkm"
        uuid dispute_id FK "disputes(id)"
        timestamptz created_at
        timestamptz updated_at
    }

    DISPUTES {
        uuid id PK
        uuid registration_id FK UK "registrations(id)"
        uuid umkm_id FK "profiles(id)"
        uuid supplier_id FK "profiles(id)"
        jsonb photo_urls
        dispute_status status
        uuid admin_id FK "profiles(id)"
        text admin_notes
        timestamptz decided_at
        timestamptz created_at
        timestamptz updated_at
    }

    DISPUTE_EVIDENCE {
        uuid id PK
        uuid dispute_id FK "disputes(id)"
        text file_url
        uuid uploaded_by FK "profiles(id)"
        timestamptz created_at
    }

    %% ===================== MODULE 8: REFUNDS & RATINGS =====================
    REFUND_REQUESTS {
        uuid id PK
        uuid registration_id FK "registrations(id)"
        uuid batch_id FK "batches(id)"
        refund_trigger trigger_type
        numeric amount
        refund_status status
        uuid umkm_bank_account_id FK "umkm_bank_accounts(id)"
        uuid admin_id FK "profiles(id)"
        text admin_notes
        text transfer_proof_url
        timestamptz requested_at
        timestamptz processed_at
        timestamptz completed_at
        timestamptz created_at
    }

    RATINGS {
        uuid id PK
        uuid registration_id FK UK "registrations(id)"
        uuid umkm_id FK "profiles(id)"
        uuid supplier_id FK "profiles(id)"
        smallint score "1..5"
        text comment
        timestamptz created_at
    }

    %% ===================== MODULE 9&10: NOTIFICATIONS & AUDIT =====================
    NOTIFICATIONS {
        uuid id PK
        uuid user_id FK "profiles(id)"
        notification_type type
        text title
        text message
        jsonb data
        timestamptz read_at
        boolean sent_via_whatsapp
        timestamptz created_at
    }

    ADMIN_AUDIT_LOGS {
        uuid id PK
        uuid admin_id FK "profiles(id)"
        audit_action action_type
        text target_type
        uuid target_id
        jsonb details
        text ip_address
        text user_agent
        timestamptz created_at
    }

    %% ===================== MODULE 11: SUPPLIER FINANCE =====================
    SUPPLIER_LEDGER_ENTRIES {
        uuid id PK
        uuid supplier_id FK "profiles(id)"
        text bucket "escrow|payout|refund|adjustment"
        numeric amount
        uuid ref_id
        text ref_type "registration|refund_request|payout"
        timestamptz created_at
    }

    SUPPLIER_PAYOUTS {
        uuid id PK
        uuid supplier_id FK "profiles(id)"
        numeric amount
        timestamptz paid_at
        text transfer_proof_url
        uuid admin_id FK "profiles(id)"
        timestamptz created_at
    }

    %% ===================== RELATIONSHIPS =====================
    PROFILES ||--|| SUPPLIER_PROFILES : "1:1 (supplier)"
    PROFILES ||--|| UMKM_PROFILES : "1:1 (umkm)"
    PROFILES ||--o{ SUPPLIER_BANK_ACCOUNTS : "1:N"
    PROFILES ||--o{ UMKM_BANK_ACCOUNTS : "1:N"
    PROFILES ||--o{ BATCHES : "1:N (supplier)"
    PROFILES ||--o{ RECURRING_CONFIGS : "1:N (supplier)"
    PROFILES ||--o{ REGISTRATIONS : "1:N (umkm)"
    PROFILES ||--o{ PAYMENT_WEBHOOK_LOGS : "1:N (via registration)"
    PROFILES ||--o{ PICKUP_EVENTS : "1:N (supplier)"
    PROFILES ||--o{ DISPUTES : "1:N (umkm)"
    PROFILES ||--o{ DISPUTES : "1:N (supplier)"
    PROFILES ||--o{ DISPUTE_EVIDENCE : "1:N (uploader)"
    PROFILES ||--o{ REFUND_REQUESTS : "1:N (admin)"
    PROFILES ||--o{ NOTIFICATIONS : "1:N (user)"
    PROFILES ||--o{ ADMIN_AUDIT_LOGS : "1:N (admin)"
    PROFILES ||--o{ SUPPLIER_LEDGER_ENTRIES : "1:N (supplier)"
    PROFILES ||--o{ SUPPLIER_PAYOUTS : "1:N (supplier)"

    BATCHES ||--o{ BATCH_TIERS : "1:N"
    BATCHES ||--|| BATCH_TIMELINE : "1:1"
    BATCHES ||--o{ RECURRING_CONFIGS : "1:N (recurring)"
    BATCHES ||--o{ REGISTRATIONS : "1:N"
    BATCHES ||--o{ REFUND_REQUESTS : "1:N"

    REGISTRATIONS ||--|| REGISTRATION_COUNTERS : "1:1 (via batch)"
    REGISTRATIONS ||--|| PAYMENTS : "1:1"
    REGISTRATIONS ||--|| PICKUP_CODES : "1:1"
    REGISTRATIONS ||--o{ PICKUP_EVENTS : "1:N"
    REGISTRATIONS ||--|| ESCROW_HOLDS : "1:1"
    REGISTRATIONS ||--|| DISPUTES : "1:1"
    REGISTRATIONS ||--o{ REFUND_REQUESTS : "1:N"
    REGISTRATIONS ||--|| RATINGS : "1:1"

    DISPUTES ||--o{ DISPUTE_EVIDENCE : "1:N"
    ESCROW_HOLDS }|--|| DISPUTES : "N:1 (dispute link)"

    SUPPLIER_BANK_ACCOUNTS }|--|| PROFILES : "N:1 (supplier)"
    UMKM_BANK_ACCOUNTS }|--|| PROFILES : "N:1 (umkm)"
    REFUND_REQUESTS }|--|| UMKM_BANK_ACCOUNTS : "N:1 (bank account)"

    %% ===================== STORAGE (Conceptual) =====================
    WESUP_ASSETS {
        bucket wesup-assets (private)
        folder ktp/
        folder business/
        folder disputes/
        folder dispute-evidence/
        folder archive/
    }

    WESUP_PUBLIC {
        bucket wesup-public (public)
        folder products/
    }

    SUPPLIER_PROFILES ..> WESUP_ASSETS : "ktp_photo_url, business_photo_url"
    BATCHES ..> WESUP_PUBLIC : "product_photo_url"
    DISPUTES ..> WESUP_ASSETS : "photo_urls[]"
    DISPUTE_EVIDENCE ..> WESUP_ASSETS : "file_url"