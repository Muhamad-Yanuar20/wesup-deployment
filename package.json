{
  "name": "wesup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run db:check:transaction-ux && npm run db:check:order-integrity -- --schema-only",
    "db:check:order-integrity": "node scripts/check-order-status-integrity.mjs",
    "db:recover:order-integrity": "node scripts/recover-order-status-incident.mjs",
    "db:check:transaction-ux": "node scripts/check-transaction-ux-schema.mjs",
    "predev": "npm run db:check:transaction-ux",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean:deadcode": "npm run clean:unused && npm run clean:unreachable && npm run clean:deps",
    "clean:unused": "knip",
    "clean:unreachable": "ts-prune",
    "clean:deps": "depcheck --ignores=\"@types/*,eslint-config-*,eslint,prettier\"",
    "db:check:supplier-transactions": "node scripts/check-supplier-transaction-schema.mjs",
    "payments:check": "node scripts/check-payment-readiness.mjs",
    "db:recover:supplier-transactions": "node scripts/recover-supplier-transaction-incident.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@upstash/redis": "^1.38.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.32.0",
    "next": "16.2.10",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "swagger-ui-react": "^5.33.0",
    "three": "^0.186.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.10",
    "depcheck": "^1.4.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "knip": "^6.38.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.22.0",
    "pgsql-ast-parser": "^12.0.2",
    "tailwindcss": "^4",
    "ts-prune": "^0.10.3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
